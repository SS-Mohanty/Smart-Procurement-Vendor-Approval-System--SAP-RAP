@Metadata.layer: #CORE
@UI: {
  headerInfo: {
    typeName: 'Requested Item',
    typeNamePlural: 'Requested Items',
    typeImageUrl: 'https://upload.wikimedia.org/wikipedia/en/b/bd/Odisha_University_of_Technology_and_Research_Logo.png',
    title: { type: #STANDARD, label: 'Item Number', value: 'item_number' },
    description: { type: #STANDARD, value: 'item_description' }
  }
}
annotate view ZC_PROJ_PR_ITEM with
{
  @UI.facet: [
    {
      id: 'ItemData',
      purpose: #STANDARD,
      type: #IDENTIFICATION_REFERENCE,
      label: 'Item Details',
      position: 10
    }
  ]

  @UI.hidden: true
  purchase_request_item_uuid;

  @UI.hidden: true
  purchase_request_uuid;

  @UI: {
    lineItem:       [ { position: 10, label: 'Item Number' } ],
    identification: [ { position: 10, label: 'Item Number' } ]
  }
  item_number;

  @UI: {
    lineItem:       [ { position: 20, label: 'Description' } ],
    identification: [ { position: 20, label: 'Description' } ]
  }
  item_description;

  @UI: {
    lineItem:       [ { position: 30, label: 'Quantity' } ],
    identification: [ { position: 30, label: 'Quantity' } ]
  }
  quantity;

  @UI: {
    lineItem:       [ { position: 40, label: 'UoM' } ],
    identification: [ { position: 40, label: 'Unit of Measure' } ]
  }
  unit_of_measure;

  @UI: {
    lineItem:       [ { position: 50, label: 'Unit Price' } ],
    identification: [ { position: 50, label: 'Unit Price' } ]
  }
  unit_price;

  @UI.hidden: true
  currency_code;

  @UI.hidden: true
  local_last_changed_at;
}